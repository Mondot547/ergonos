# Copier vers .env (jamais committé). Aucune valeur réelle ici.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/boutique?schema=public"
SITE_URL="http://localhost:3000"

# Stripe — clés de TEST uniquement (sk_test_… / whsec_… du CLI ou du dashboard test)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Garde-fou : la boutique refuse de démarrer un paiement avec une clé live tant que ceci n'est pas "true"
ALLOW_LIVE_PAYMENTS="false"

# Livraison : montant forfaitaire en centimes, À DÉFINIR par le commerçant (0 = gratuit par défaut, non validé)
SHIPPING_FLAT_CENTS="0"

# BigBuy — désactivé par défaut (voir docs/BIGBUY.md)
BIGBUY_ENABLED="false"
BIGBUY_API_KEY=""
BIGBUY_BASE_URL="https://api.bigbuy.eu"
BIGBUY_FIELD_MAPPING_VERIFIED="false"
